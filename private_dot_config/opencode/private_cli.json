{
	"$schema": "https://opencode.ai/v2/cli.json",
	"theme": {
		"name": "system"
	},
	"animations": true,
	"cursor": {
		"style": "default"
	},
	"mouse": true,
	"prompt": {
		"paste": "full"
	},
	"session": {
		"tps": true,
		"scrollbar": true,
		"thinking": "show",
		"sidebar": "hide"
	},
	"tabs": {
		"indicators": "numbers"
	},
	"leader": {
		"timeout": 30000
	},
	"plugins": [
		"opencode-v2-cli-codex-usage@1.0.1",
		"./herdr-opencode",
		"-opencode.notifications",
		"./plugins/desktop-notifications"
	],
	"keybinds": {
		"leader": "ctrl+t",
		"app.exit": ["<leader>shift+q"],
		"app.debug": false,
		"app.console": false,
		"app.scrap": false,
		"app.toggle.animations": false,
		"app.toggle.file_context": false,
		"app.toggle.diffwrap": false,
		"app.toggle.paste_summary": false,
		"app.clear": false,
		"command.palette.show": "ctrl+p",
		"help.show": false,
		"docs.open": false,
		"opencode.settings": false,
		"server.pair": false,
		"service.restart": false,

		"diff.open": false,
		"diff.close": false,
		"diff.down": false,
		"diff.up": false,
		"diff.page.down": false,
		"diff.page.up": false,
		"diff.half_page.down": false,
		"diff.half_page.up": false,
		"diff.first": false,
		"diff.last": false,
		"diff.next_hunk": false,
		"diff.previous_hunk": false,
		"diff.next_file": false,
		"diff.previous_file": false,
		"diff.toggle_file_tree": false,
		"diff.single_patch": false,
		"diff.switch_source": false,
		"diff.toggle_view": false,
		"diff.mark_reviewed": false,
		"diff.help": false,

		"theme.switch": false,
		"theme.switch_mode": false,
		"theme.mode.lock": false,
		"opencode.status": false,
		"opencode.debug": false,
		"session.toggle.scrollbar": false,
		"session.sidebar.toggle": "ctrl+s",

		"session.export": false,
		"session.copy": false,
		"session.move": false,
		"session.new": ["<leader>n", "<leader>ctrl+n"],
		"session.list": ["<leader>ctrl+s", "<leader>s"],
		"open.menu": false,
		"session.timeline": false,
		"session.fork": false,
		"session.rename": false,
		"session.delete": false,
		"session.share": false,
		"session.unshare": false,
		"session.interrupt": "<leader>escape",
		"session.background": false,
		"session.compact": false,
		"session.aside": false,
		"session.cd": false,
		"session.queued_prompts": false,
		"queued_prompt.undo": false,
		"queued_prompt.delete": false,
		"session.toggle.exploration_grouping": false,
		"session.child.first": false,
		"session.child.next": false,
		"session.child.previous": false,
		"session.parent": false,
		"session.pin.toggle": false,

		"session.tab.next": ["<leader>l", "<leader>ctrl+l"],
		"session.tab.previous": ["<leader>h", "<leader>ctrl+h"],
		"session.tab.history.back": false,
		"session.tab.history.forward": false,
		"session.tab.next_unread": false,
		"session.tab.previous_unread": false,
		"session.tab.close": "<leader>w",
		"session.tab.reopen": ["<leader>ctrl+shift+t"],
		"session.tab.select.1": "<leader>1",
		"session.tab.select.2": "<leader>2",
		"session.tab.select.3": "<leader>3",
		"session.tab.select.4": "<leader>4",
		"session.tab.select.5": "<leader>5",
		"session.tab.select.6": "<leader>6",
		"session.tab.select.7": "<leader>7",
		"session.tab.select.8": "<leader>8",
		"session.tab.select.9": "<leader>9",
		"session.tab.select.10": false,
		"session.quick_switch.1": false,
		"session.quick_switch.2": false,
		"session.quick_switch.3": false,
		"session.quick_switch.4": false,
		"session.quick_switch.5": false,
		"session.quick_switch.6": false,
		"session.quick_switch.7": false,
		"session.quick_switch.8": false,
		"session.quick_switch.9": false,

		"session.page.up": "pageup",
		"session.page.down": "pagedown",
		"session.line.up": "alt+k",
		"session.line.down": "alt+j",
		"session.half.page.up": false,
		"session.half.page.down": false,
		"session.first": "alt+0",
		"session.last": "alt+4",
		"session.message.next": "alt+shift+j",
		"session.message.previous": "alt+shift+k",
		"session.message.user.next": false,
		"session.message.user.previous": false,
		"session.messages_last_user": false,
		"messages.copy": "alt+c",
		"session.undo": false,
		"session.redo": false,
		"session.toggle.thinking": false,

		"model.dialog.provider": false,
		"model.dialog.favorite": false,
		"model.list": ["<leader>m", "<leader>ctrl+m"],
		"model.cycle_recent": false,
		"model.cycle_recent_reverse": false,
		"model.cycle_favorite": false,
		"model.cycle_favorite_reverse": false,
		"mcp.list": false,
		"provider.connect": false,
		"agent.list": false,
		"agent.cycle": ["tab"],
		"agent.cycle.reverse": false,
		"variant.cycle": false,
		"variant.list": ["<leader>v", "<leader>ctrl+v"],

		"prompt.submit": false,
		"prompt.queue": false,
		"prompt.editor": "<leader>e",
		"prompt.editor_context.clear": false,
		"prompt.images.view": false,
		"prompt.skills": false,
		"prompt.stash": false,
		"prompt.stash.pop": false,
		"prompt.stash.list": false,
		"stash.delete": false,
		"prompt.clear": "ctrl+c",
		"prompt.paste": {
			"key": "ctrl+v",
			"preventDefault": false
		},
		"prompt.history.previous": "ctrl+shift+up",
		"prompt.history.next": "ctrl+shift+down",

		"input.submit": "return",
		"input.newline": ["shift+return", "ctrl+return"],
		"input.move.left": "left",
		"input.move.right": "right",
		"input.move.up": "up",
		"input.move.down": "down",
		"input.select.left": "shift+left",
		"input.select.right": "shift+right",
		"input.select.up": "shift+up",
		"input.select.down": "shift+down",
		"input.line.home": "home",
		"input.line.end": "end",
		"input.select.line.home": "ctrl+shift+a",
		"input.select.line.end": "ctrl+shift+e",
		"input.visual.line.home": "alt+a",
		"input.visual.line.end": "alt+e",
		"input.select.visual.line.home": "alt+shift+a",
		"input.select.visual.line.end": "alt+shift+e",
		"input.buffer.home": "ctrl+home",
		"input.buffer.end": "ctrl+end",
		"input.select.buffer.home": "shift+home",
		"input.select.buffer.end": "shift+end",
		"input.delete.line": "shift+delete",
		"input.delete.to.line.end": "ctrl+k",
		"input.delete.to.line.start": "ctrl+u",
		"input.backspace": "backspace",
		"input.delete": "delete",
		"input.undo": ["ctrl+-", "super+z"],
		"input.redo": ["ctrl+.", "super+shift+z"],
		"input.word.forward": ["alt+f", "alt+right", "ctrl+right"],
		"input.word.backward": ["alt+b", "alt+left", "ctrl+left"],
		"input.select.word.forward": ["alt+shift+f", "alt+shift+right"],
		"input.select.word.backward": ["alt+shift+b", "alt+shift+left"],
		"input.delete.word.forward": ["alt+d", "alt+delete", "ctrl+delete"],
		"input.delete.word.backward": [
			"ctrl+w",
			"ctrl+backspace",
			"alt+backspace"
		],
		"input.select.all": "super+a",

		"composer.subagent.up": false,
		"composer.subagent.down": false,
		"composer.subagent.select": false,
		"composer.subagent.interrupt": false,
		"composer.shell.up": false,
		"composer.shell.down": false,
		"composer.shell.select": false,
		"composer.shell.kill": false,

		"dialog.select.prev": "up",
		"dialog.select.next": "down",
		"dialog.select.page_up": false,
		"dialog.select.page_down": false,
		"dialog.select.home": false,
		"dialog.select.end": false,
		"dialog.select.submit": "return",
		"dialog.prompt.submit": "return",
		"dialog.worktree.generate": false,
		"dialog.move_session.new": false,
		"dialog.move_session.move": false,
		"dialog.move_session.delete": false,
		"dialog.move_session.refresh": false,
		"dialog.mcp.toggle": false,
		"dialog.plugins.update": false,
		"dialog.plugins.check": false,
		"prompt.autocomplete.prev": "up",
		"prompt.autocomplete.next": "down",
		"prompt.autocomplete.hide": "escape",
		"prompt.autocomplete.select": "return",
		"prompt.autocomplete.complete": "tab",
		"permission.prompt.fullscreen": false,

		"terminal.toggle": false,
		"terminal.suspend": false,
		"terminal.title.toggle": false,
		"plugins.list": false,
		"plugins.toggle": false,

		"which-key.toggle": false,
		"which-key.layout.toggle": false,
		"which-key.pending.toggle": false,
		"which-key.group.previous": false,
		"which-key.group.next": false,
		"which-key.scroll.up": false,
		"which-key.scroll.down": false,
		"which-key.page.up": false,
		"which-key.page.down": false,
		"which-key.home": false,
		"which-key.end": false
	}
}
